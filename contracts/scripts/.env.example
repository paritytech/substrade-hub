# SubsTrade Hub Bootstrap — Paseo Asset Hub
# Usage: cp scripts/.env.example scripts/.env && node scripts/bootstrap.mjs

# Network
WSS_URL="wss://asset-hub-paseo-rpc.n.dwellir.com"
RPC_URL="https://services.polkadothub-rpc.com/testnet/"

# Alice — sr25519 account, fund via Paseo faucet
# Generate: subkey generate --scheme sr25519
ALICE_SEED="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# Deployer — ECDSA account, funded automatically by bootstrap script
# Generate: cast wallet new
DEPLOYER_PRIVATE_KEY="0x..."

# Factory — deploy with: node scripts/bootstrap.mjs (phases 1-3)
# Required by bootstrap-nvda.mjs
DLOB_FACTORY_ADDRESS=0x...

# tNVDA market — set after running bootstrap-nvda.mjs phases 1-2
# Required when resuming from phase 3+
# NVDA_QUOTE_ASSET_ID=50000602
# NVDA_BASE_ASSET_ID=50000603
# NVDA_MARKET_ADDRESS=0x...
