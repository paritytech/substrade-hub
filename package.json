{
  "name": "substrade-hub",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "forge:build": "cd contracts && forge build",
    "forge:test": "cd contracts && forge test --polkadot",
    "forge:fmt": "cd contracts && forge fmt",
    "e2e": "cd e2e && cargo test -- --nocapture"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
