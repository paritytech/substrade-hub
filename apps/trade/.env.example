# Copy to .env.local and adjust as needed. All vars are optional; the app has sane fallbacks.

# Product identity for the Polkadot Triangle (".dot") host: the SignerManager dApp name / DotNS domain
# used to resolve the host product account. Defaults to window.location.host when unset, which already
# resolves to the right domain under a real substrade-hub.dot.li deploy.
VITE_PRODUCT_ACCOUNT_ID=substrade-hub.dot

# Force standalone (browser wallet) mode even when running inside a host container. Handy for local dev
# in a plain tab. Any value other than "false" (or leaving it unset) keeps host auto-detection on.
# VITE_USE_HOST_API=false
