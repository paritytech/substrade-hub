# Reference only. Vite does NOT load this file — copy it to `.env.local` (or `.env`) to apply.

# REQUIRED. Network to target: a key of src/config/networks.json. No default, so a build never silently
# targets the wrong chain.
VITE_NETWORK=previewnet

# DotNS product identity for the Polkadot Triangle (".dot") host: the SignerManager dApp name used to
# resolve the host product account via getProductAccount(id, 0). Must end in ".dot" (the SDK appends
# ".dot" to non-local names, so a bare domain like substrade-hub.dot.li would become ...".dot.li.dot").
# Defaults to "substrade-hub.dot" in code; override only for a different registered product name.
VITE_PRODUCT_ACCOUNT_ID=substrade-hub.dot

# Force standalone (browser wallet) mode even when running inside a host container. Handy for local dev
# in a plain tab. Only the exact string "false" forces standalone; unset keeps host auto-detection on.
# VITE_USE_HOST_API=false
